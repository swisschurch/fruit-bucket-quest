rules_version = '2';
// The Ripening Quest (game 2) security rules, as published on 16 November 2026.
// The Zurich Fruit Bucket Quest (game 1) has ended: its /baskets data was deleted and its rule removed,
// so no one can read or write /baskets any more (Firestore denies anything without a rule).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['zhlebensbaum@gmail.com'];
    }

    function okText(v) {
      return v is string && v.size() > 0 && v.size() <= 20;
    }

    match /public/{docId} {
      allow read: if docId in ['config', 'config2', 'summary2'] || isAdmin();
      allow write: if isAdmin();
    }

    match /redfruits/{fruitId} {
      allow read, update: if isAdmin();
      allow delete: if true;
      allow create: if request.resource.data.keys().hasOnly(['team', 'zone', 'harvester', 'fruit', 'ts'])
        && request.resource.data.keys().hasAll(['team', 'zone', 'harvester', 'fruit', 'ts'])
        && request.resource.data.team in ['t1', 't2', 't3', 't4', 't5', 't6', 't7', 't8']
        && request.resource.data.zone in ['z1', 'z2', 'z3', 'z4', 'z5']
        && okText(request.resource.data.harvester)
        && okText(request.resource.data.fruit)
        && request.resource.data.ts == request.time;
    }

    match /care2/{careId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['team', 'zone', 'harvester', 'fruit', 'kind', 'ts'])
        && request.resource.data.keys().hasAll(['team', 'zone', 'harvester', 'fruit', 'kind', 'ts'])
        && request.resource.data.team in ['t1', 't2', 't3', 't4', 't5', 't6', 't7', 't8']
        && request.resource.data.zone in ['z1', 'z2', 'z3', 'z4', 'z5']
        && okText(request.resource.data.harvester)
        && okText(request.resource.data.fruit)
        && request.resource.data.kind in ['water', 'nourish', 'sun']
        && request.resource.data.ts == request.time;
    }
  }
}
