rules_version = '2';
// Zurich Fruit Bucket Quest + The Ripening Quest (Game 2) security rules
// Replace the host email below with your Google account, paste everything into
// Firebase console > Firestore > Rules, and click Publish.
// For several hosts: ['a@gmail.com', 'b@gmail.com']
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR_EMAIL@gmail.com'];
    }

    function okText(v) {
      return v is string && v.size() > 0 && v.size() <= 20;
    }

    // Team names/quotas (config) and the phone summary: anyone reads, only hosts write
    match /public/{docId} {
      // Bucket game closed: its summary and keys (they hold names) are host-only now.
      allow read: if docId in ['config', 'config2', 'summary2'] || isAdmin();
      allow write: if isAdmin();
    }

    // Bucket records: participants can only add; only hosts can read the real names
    match /baskets/{basketId} {
      allow read, update: if isAdmin();
      // The host can delete anything. A phone can delete a bucket only by its id, which only
      // the phone that added it knows (participants can't list buckets, and ids are never published).
      // Bucket game closed on 13 Nov 2026: no new buckets, and only the host can delete.
      allow delete: if isAdmin();
      allow create: if false && request.resource.data.keys().hasOnly(['team', 'zone', 'harvester', 'basket', 'relation', 'ts'])
        && request.resource.data.keys().hasAll(['team', 'zone', 'harvester', 'basket', 'relation', 'ts'])
        && request.resource.data.team in ['t1', 't2', 't3', 't4', 't5', 't6', 't7', 't8']
        && request.resource.data.zone in ['z1', 'z2', 'z3', 'z4', 'z5']
        && okText(request.resource.data.harvester)
        && okText(request.resource.data.basket)
        && okText(request.resource.data.relation)
        && request.resource.data.ts == request.time;
    }

    // Game 2 (The Ripening Quest): one record per red fruit. Same pattern as buckets.
    match /redfruits/{fruitId} {
      allow read, update: if isAdmin();
      allow delete: if true;
      allow create: if request.resource.data.keys().hasOnly(['team', 'zone', 'harvester', 'fruit', 'ts'])
        && request.resource.data.keys().hasAll(['team', 'zone', 'harvester', 'fruit', 'ts'])
        && request.resource.data.team in ['t1', 't2', 't3', 't4', 't5', 't6', 't7', 't8']
        && request.resource.data.zone in ['z1', 'z2', 'z3', 'z4', 'z5']
        && okText(request.resource.data.harvester)
        && okText(request.resource.data.fruit)
        && request.resource.data.ts == request.time;
    }

    // Game 2 feed: each Water / Nourish / Sunlight / Catch bugs step (shown on the big screen)
    match /care2/{careId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['team', 'zone', 'harvester', 'fruit', 'kind', 'ts'])
        && request.resource.data.keys().hasAll(['team', 'zone', 'harvester', 'fruit', 'kind', 'ts'])
        && request.resource.data.team in ['t1', 't2', 't3', 't4', 't5', 't6', 't7', 't8']
        && request.resource.data.zone in ['z1', 'z2', 'z3', 'z4', 'z5']
        && okText(request.resource.data.harvester)
        && okText(request.resource.data.fruit)
        && request.resource.data.kind in ['water', 'nourish', 'sun', 'bug']
        && request.resource.data.ts == request.time;
    }
  }
}
